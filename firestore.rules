rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validTagAt(tags, index) {
      return tags.size() <= index
        || (tags[index] is string
          && tags[index].size() >= 1
          && tags[index].size() <= 30);
    }

    function validProfile() {
      let data = request.resource.data;
      let tags = data.interests;
      return data.keys().hasAll(['bio', 'department', 'year', 'interests', 'updatedAt'])
        && data.keys().hasOnly(['bio', 'department', 'year', 'interests', 'updatedAt'])
        && data.bio is string
        && data.bio.size() <= 280
        && data.department is string
        && data.department.size() <= 100
        && data.year is string
        && data.year.size() <= 20
        && data.year in ['', 'ปี 1', 'ปี 2', 'ปี 3', 'ปี 4', 'ปี 5 ขึ้นไป']
        && tags is list
        && tags.size() <= 10
        && tags.toSet().size() == tags.size()
        && validTagAt(tags, 0)
        && validTagAt(tags, 1)
        && validTagAt(tags, 2)
        && validTagAt(tags, 3)
        && validTagAt(tags, 4)
        && validTagAt(tags, 5)
        && validTagAt(tags, 6)
        && validTagAt(tags, 7)
        && validTagAt(tags, 8)
        && validTagAt(tags, 9)
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validProfile();
      allow delete: if false;
    }

    function isMatchParticipant(matchData) {
      return request.auth != null
        && matchData.participants is list
        && matchData.participants.size() == 2
        && matchData.participants[0] is string
        && matchData.participants[1] is string
        && matchData.participants[0] != matchData.participants[1]
        && request.auth.uid in matchData.participants;
    }

    function isChatParticipant(matchId) {
      let matchPath = /databases/$(database)/documents/matches/$(matchId);
      return request.auth != null
        && exists(matchPath)
        && isMatchParticipant(get(matchPath).data);
    }

    match /matches/{matchId} {
      allow read: if isMatchParticipant(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(matchId);
        allow create: if isChatParticipant(matchId)
          && request.resource.data.keys().hasAll(['authorId', 'text', 'sentAt'])
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'sentAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
